# ==================== SITETRACKERPRO v3.0 ENHANCED .ENV ====================

# Backend Port
PORT=3000

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sitetrackerpro_v3_enhanced

# Signs every login token. The app REFUSES TO START without a real value:
# 32+ characters, not this example, not one repeated pattern.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Browser origins allowed to call the API cross-origin, comma separated.
# Leave empty for same-origin only (the normal deployment). A "*" is refused.
# Example: CORS_ORIGIN=https://app.example.com,http://localhost:3000
CORS_ORIGIN=

# How many proxies sit in front of the API. Caddy/nginx = 1, which lets rate
# limiting see the real client IP. Set to false only if the API is exposed directly.
TRUST_PROXY=1

# Frontend
REACT_APP_API_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
