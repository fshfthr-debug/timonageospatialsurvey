# Copy this file to deploy/.env and fill in every value.
#   cp deploy/.env.example deploy/.env
#   openssl rand -hex 24     # for DB_PASSWORD
#   openssl rand -hex 32     # for JWT_SECRET
# compose refuses to start while DB_PASSWORD or JWT_SECRET are empty.

# The public hostname Caddy will get a free certificate for.
# With no domain yet, put the server's IP address here and use Caddyfile.http.
APP_DOMAIN=app.example.com

# PostgreSQL, created automatically on first start.
DB_NAME=sitetrackerpro_v3_enhanced
DB_USER=sitetrackerpro
DB_PASSWORD=replace-with-output-of-openssl-rand-hex-24

# Signs every login token. The app refuses to start without a real value:
# 32+ characters, not this placeholder, not one repeated pattern. Changing it
# logs everyone out.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# The browser origin(s) allowed to call the API cross-origin, comma separated.
# compose passes this to the API as CORS_ORIGIN. With the frontend served from the
# same domain (the normal setup) this is belt-and-braces, not a requirement.
APP_ORIGIN=https://app.example.com

# How many proxies sit in front of the API (Caddy = 1). Rate limiting uses this to
# find the real client IP; if it is wrong, one person's failed logins lock out all.
TRUST_PROXY=1
